# Amazon Bedrock API key (bearer token) used by langchain-aws / boto3
AWS_BEARER_TOKEN_BEDROCK=
# AWS region where Bedrock models are enabled, e.g. eu-west-2
AWS_DEFAULT_REGION=
# Optional override for Bedrock chat model ID (defaults to eu.anthropic.claude-sonnet-5-5)
BEDROCK_CHAT_MODEL_ID=
# SEC EDGAR User-Agent identity, format: "Your Name your@email.com"
EDGAR_IDENTITY=
# Neo4j connection URI, e.g. bolt://localhost:7687
NEO4J_URI=
# Neo4j username
NEO4J_USERNAME=
# Neo4j password
NEO4J_PASSWORD=
